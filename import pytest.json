def test_custom_config_structure():
    """Test that the custom configuration dictionary has the expected structure and types."""
    # Check that custom_config is a dictionary
    assert isinstance(custom_config, dict), "Custom config should be a dictionary"
    
    # Check for required keys
    expected_keys = [
        'box_loss_gain', 'cls_loss_gain', 'dfl_loss_gain',
        'hsv_h', 'hsv_s', 'hsv_v',
        'degrees', 'translate', 'scale', 'shear', 'perspective',
        'flipud', 'fliplr', 'mosaic', 'mixup'
    ]
    for key in expected_keys:
        assert key in custom_config, f"Expected key '{key}' is missing from custom_config"

    # Check types of values
    for key, value in custom_config.items():
        assert isinstance(value, (int, float, bool)), f"Value for '{key}' must be int, float, or bool"


@patch('ultralytics.YOLO')
def test_yolo_initialization(mock_yolo):
    """Test that the YOLO model is initialized with the correct parameters."""
    
    # Check that YOLO was called once with the correct parameter
    mock_yolo.assert_called_once_with('yolov12s.yaml')
    
    # Check that model is an instance of the mocked YOLO
    assert model is mock_yolo.return_value


@patch('ultralytics.YOLO')
def test_model_train_called_with_correct_args(mock_yolo):
    """Test that model.train() is called with the correct arguments."""
    # Create a mock for the train method
    mock_train = MagicMock()
    mock_yolo.return_value.train = mock_train
    
    # Run the code that calls model.train()
    
    # Extract the call arguments from the mock
    args, kwargs = mock_train.call_args
    
    # Check that the expected arguments are passed
    assert 'epochs' in kwargs and kwargs['epochs'] == 250, "Epochs should be 250"
    assert 'imgsz' in kwargs and kwargs['imgsz'] == 640, "Image size should be 640"
    assert 'patience' in kwargs and kwargs['patience'] == 50, "Patience should be 50"
    assert 'batch' in kwargs and kwargs['batch'] == 16, "Batch size should be 16"
    assert 'rect' in kwargs and kwargs['rect'] is True, "Rectangular training should be enabled"


@patch('ultralytics.YOLO')
def test_yolo_valid_hyperparameters(mock_yolo):
    """Test that the YOLO train method is called with valid hyperparameters."""
    
    # Get the signature of the get_cfg function to see valid parameters
    valid_params = list(inspect.signature(get_cfg).parameters.keys())
    
    # Check if the custom config keys are valid YOLO parameters
    invalid_params = []
    for key in custom_config.keys():
        if key not in valid_params:
            invalid_params.append(key)
    
    # The test should expect these specific invalid parameters based on the error message
    expected_invalid = ['box_loss_gain', 'cls_loss_gain', 'dfl_loss_gain']
    assert set(invalid_params) == set(expected_invalid), \
        f"Expected invalid parameters {expected_invalid}, but found {invalid_params}"


@patch('ultralytics.YOLO')
def test_train_with_corrected_params(mock_yolo):
    """Test training with corrected parameter names that match valid YOLO arguments."""
    mock_train = MagicMock()
    mock_yolo.return_value.train = mock_train
    
    # Create a corrected version of the custom config with valid parameter names
    corrected_config = {
        # Replace invalid parameters with valid ones
        'box': 7.5,  # Instead of 'box_loss_gain'
        'cls': 0.5,  # Instead of 'cls_loss_gain'
        'dfl': 1.5,  # Instead of 'dfl_loss_gain'
        
        # Keep valid parameters
        'hsv_h': 0.015,
        'hsv_s': 0.7,
        'hsv_v': 0.4,
        'degrees': 0,
        'translate': 0.1,
        'scale': 0.5,
        'shear': 0,
        'perspective': 0.0,
        'flipud': 0.0,
        'fliplr': 0.5,
        'mosaic': 0.0,
        'mixup': 0.0,
    }
    
    # Mock dataset path
    dataset_path = "/path/to/dataset"
    
    # Call train with the corrected config
    model = mock_yolo.return_value
    model.train(
        data=f'{dataset_path}/data.yaml',
        epochs=250,
        imgsz=640,
        patience=50,
        batch=16,
        rect=True,
        **corrected_config
    )
    
    # Check that train was called once
    mock_train.assert_called_once()
    
    # Extract the keyword arguments
    _, kwargs = mock_train.call_args
    
    # Check that the corrected parameters were passed
    assert 'box' in kwargs and kwargs['box'] == 7.5
    assert 'cls' in kwargs and kwargs['cls'] == 0.5
    assert 'dfl' in kwargs and kwargs['dfl'] == 1.5


